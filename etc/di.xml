<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Contributes this module's reporters to StackNuts_StackGauge's fleet report - see
         StackNuts\StackGauge\Api\ReporterInterface for the contract. -->
    <type name="StackNuts\StackGauge\Model\ReporterPool">
        <arguments>
            <argument name="reporters" xsi:type="array">
                <item name="php_runtime" xsi:type="object">StackNuts\StackGaugePerformance\Model\Reporter\PhpRuntimeReporter</item>
                <item name="mysql_runtime" xsi:type="object">StackNuts\StackGaugePerformance\Model\Reporter\MysqlRuntimeReporter</item>
                <item name="redis_perf" xsi:type="object">StackNuts\StackGaugePerformance\Model\Reporter\RedisPerformanceReporter</item>
                <item name="cron_perf" xsi:type="object">StackNuts\StackGaugePerformance\Model\Reporter\CronPerformanceReporter</item>
            </argument>
        </arguments>
    </type>
</config>
