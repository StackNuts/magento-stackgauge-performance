<?xml version="1.0"?>
<ruleset name="StackNuts module">
    <description>Magento2 coding standard for this module.</description>
    <file>.</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <arg name="extensions" value="php,phtml"/>
    <arg name="colors"/>
    <rule ref="Magento2"/>
</ruleset>
